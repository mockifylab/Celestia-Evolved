pragma ComponentBehavior: Bound

import QtQuick
import QtQuick.Layouts
import Quickshell.Io
import Caelestia.Components
import Caelestia.Config
import Caelestia.I18n
import qs.components
import qs.components.controls
import qs.services
import qs.modules.nexus.common

PageBase {
    id: root

    // The shell derives its palette through the external `caelestia` CLI, which
    // regenerates scheme.json from the active wallpaper. Detect it up front so we
    // can be honest about which controls can actually take effect.
    property bool cliAvailable: false
    property bool cliChecked: false

    readonly property var paletteRoles: [
        {
            name: Tr.tr("Primary"),
            colour: Colours.palette.m3primary
        },
        {
            name: Tr.tr("On primary"),
            colour: Colours.palette.m3onPrimary
        },
        {
            name: Tr.tr("Container"),
            colour: Colours.palette.m3primaryContainer
        },
        {
            name: Tr.tr("Secondary"),
            colour: Colours.palette.m3secondary
        },
        {
            name: Tr.tr("Tertiary"),
            colour: Colours.palette.m3tertiary
        },
        {
            name: Tr.tr("Error"),
            colour: Colours.palette.m3error
        },
        {
            name: Tr.tr("Success"),
            colour: Colours.palette.m3success
        },
        {
            name: Tr.tr("Surface"),
            colour: Colours.palette.m3surface
        },
        {
            name: Tr.tr("Elevated"),
            colour: Colours.palette.m3surfaceContainerHigh
        },
        {
            name: Tr.tr("Outline"),
            colour: Colours.palette.m3outline
        }
    ]

    function refreshFromWallpaper(): void {
        Colours.setMode(Colours.light ? "light" : "dark");
    }

    title: Tr.tr("Colours")
    isSubPage: true

    Component.onCompleted: cliCheck.running = true

    ColumnLayout {
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        width: root.cappedWidth
        spacing: Tokens.spacing.extraSmall / 2

        Process {
            id: cliCheck

            command: ["sh", "-c", "command -v caelestia"]
            onRunningChanged: {
                if (!running) {
                    root.cliAvailable = cliCheck.exitCode === 0; // qmllint disable missing-property
                    root.cliChecked = true;
                }
            }
        }

        // Missing-CLI notice
        ConnectedRect {
            visible: root.cliChecked && !root.cliAvailable
            first: true
            last: true
            Layout.fillWidth: true
            implicitHeight: noticeLayout.implicitHeight + Tokens.padding.largeIncreased * 2

            RowLayout {
                id: noticeLayout

                anchors.fill: parent
                anchors.margins: Tokens.padding.largeIncreased
                spacing: Tokens.spacing.medium

                MaterialIcon {
                    Layout.alignment: Qt.AlignTop
                    Layout.topMargin: Tokens.padding.extraSmall
                    text: "priority_high"
                    color: Colours.palette.m3tertiary
                    fontStyle: Tokens.font.icon.medium
                }

                StyledText {
                    Layout.fillWidth: true
                    wrapMode: Text.WordWrap
                    text: Tr.tr("Wallpaper-derived colours are generated by the 'caelestia' command line tool, which is not installed. Mode and refresh controls below take effect once it is available.")
                    color: Colours.palette.m3onSurfaceVariant
                    font: Tokens.font.body.small
                }
            }
        }

        // Theme mode
        SectionHeader {
            first: root.cliChecked && root.cliAvailable
            text: Tr.tr("Theme mode")
        }

        ToggleRow {
            first: true
            last: true
            text: Tr.tr("Light theme")
            subtext: Tr.tr("Switch the shell between light and dark palettes")
            checked: Colours.light
            onToggled: Colours.setMode(checked ? "light" : "dark")
        }

        // Scheme
        SectionHeader {
            text: Tr.tr("Colour scheme")
        }

        ConnectedRect {
            first: true
            Layout.fillWidth: true
            implicitHeight: schemeRow.implicitHeight + Tokens.padding.large * 2

            RowLayout {
                id: schemeRow

                anchors.fill: parent
                anchors.margins: Tokens.padding.large
                anchors.leftMargin: Tokens.padding.largeIncreased
                anchors.rightMargin: Tokens.padding.largeIncreased
                spacing: Tokens.spacing.medium

                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: Tokens.spacing.extraSmall

                    StyledText {
                        text: Tr.tr("Scheme")
                        font: Tokens.font.body.small
                    }

                    StyledText {
                        text: Colours.scheme || Tr.tr("Default")
                        color: Colours.palette.m3outline
                        font: Tokens.font.label.small
                    }
                }

                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: Tokens.spacing.extraSmall

                    StyledText {
                        text: Tr.tr("Variant")
                        font: Tokens.font.body.small
                    }

                    StyledText {
                        text: Colours.flavour || Tr.tr("None")
                        color: Colours.palette.m3outline
                        font: Tokens.font.label.small
                    }
                }
            }
        }

        ToggleRow {
            last: true
            text: Tr.tr("Use wallpaper colours")
            subtext: Tr.tr("Regenerate the palette from the active wallpaper")
            checked: Config.background.wallpaperEnabled
            onToggled: {
                GlobalConfig.background.wallpaperEnabled = checked;
                if (checked)
                    root.refreshFromWallpaper();
            }
        }

        ButtonRow {
            Layout.alignment: Qt.AlignHCenter
            Layout.topMargin: Tokens.spacing.small
            spacing: Tokens.spacing.small

            IconTextButton {
                icon: "refresh"
                text: Tr.tr("Refresh from wallpaper")
                font: Tokens.font.body.large
                isRound: true
                shapeMorph: true
                type: IconTextButton.Tonal
                horizontalPadding: Tokens.padding.extraLarge
                verticalPadding: Tokens.padding.medium
                onClicked: root.refreshFromWallpaper()
            }
        }

        // Live palette preview
        SectionHeader {
            text: Tr.tr("Current palette")
        }

        ConnectedRect {
            first: true
            last: true
            Layout.fillWidth: true
            implicitHeight: paletteGrid.implicitHeight + Tokens.padding.largeIncreased * 2

            GridLayout {
                id: paletteGrid

                anchors.fill: parent
                anchors.margins: Tokens.padding.largeIncreased
                columns: 5
                rowSpacing: Tokens.spacing.medium
                columnSpacing: Tokens.spacing.medium

                Repeater {
                    model: root.paletteRoles

                    ColumnLayout {
                        id: roleCell

                        required property var modelData

                        Layout.fillWidth: true
                        spacing: Tokens.spacing.extraSmall

                        StyledClippingRect {
                            Layout.fillWidth: true
                            implicitHeight: Tokens.padding.extraExtraLarge

                            color: roleCell.modelData.colour
                            radius: Tokens.rounding.medium
                            border.width: 1
                            border.color: Colours.palette.m3outlineVariant
                        }

                        StyledText {
                            Layout.fillWidth: true
                            text: roleCell.modelData.name
                            elide: Text.ElideRight
                            color: Colours.palette.m3onSurfaceVariant
                            font: Tokens.font.label.small
                        }
                    }
                }
            }
        }
    }
}
